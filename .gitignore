# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# PyInstaller / Build outputs
build/
dist/
*.manifest
*.spec.bak

# Large archives and temporary caches
*.rar
*.zip
map_cache/
.autopptx_studio_v2/

# Dữ liệu làm việc (Excel, PPTX mẫu, list bán hàng, sao lưu, script 1 lần) — data/
data/
*.xlsx
*.pptx

# Cache kho tài nguyên: app tự tải từ máy chủ (server/), không đưa vào git
Data avatar/
Data background/

# Bản server chạy thử trên máy
server/data/
server/_unused_data/

# Cấu hình chạy thử riêng máy (Claude Code preview)
.claude/

# Environment / Secret variables
.env
venv/
ENV/
env/

# IDE settings
.agents/
.vscode/
.idea/
*.swp
*.swo
.DS_Store
