[Unit]
Description=AutoPPTX kho tai nguyen (FILE TONG, avatar, anh nen, tai khoan)
After=network.target

[Service]
User=autopptx
Group=autopptx
Environment=AP_DATA=/var/lib/autopptx
Environment=AP_BIND=127.0.0.1
Environment=AP_PORT=8780
Environment=AP_URL_PREFIX=/pptx
Environment=AP_ACCEL_PREFIX=/pptx-store/
Environment=AP_COOKIE_PATH=/pptx/
Environment=AP_COOKIE_SECURE=1
Environment=AP_AVATAR_MAX_PX=1600
Environment=AP_MAX_UPLOAD_MB=64
ExecStart=/usr/bin/python3 /opt/autopptx-server/autopptx_server.py serve
Restart=always
RestartSec=2
UMask=0027
LimitNOFILE=65536
# Không để kho ảnh làm nghẹt trang talent chạy cùng máy.
CPUQuota=150%
MemoryMax=1500M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/autopptx

[Install]
WantedBy=multi-user.target
